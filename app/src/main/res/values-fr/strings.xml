    <string name="scratch_quiz_option_c">Dessiner des images</string>
    <string name="scratch_quiz_explanation">Scratch est un langage de programmation visuel où vous faites glisser et connectez des blocs pour créer des programmes, des jeux et des animations.</string>

    <!-- AI Game -->
    <string name="ai_instructions">Complétez le défi IA sur l\'appareil fourni.\nQuand vous avez terminé, entrez le code que vous avez reçu :</string>
