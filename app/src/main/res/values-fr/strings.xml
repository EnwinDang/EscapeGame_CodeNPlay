    <string name="ai_quiz_option_a">Intelligence Artificielle</string>
    <string name="ai_quiz_option_b">Internet Automatique</string>
    <string name="ai_quiz_option_c">Interface Android</string>
    <string name="ai_quiz_explanation">IA signifie Intelligence Artificielle — des systèmes capables d\'apprendre à partir de données et de résoudre des problèmes d\'une manière similaire à la pensée humaine.</string>

