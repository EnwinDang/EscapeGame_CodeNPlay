    <!-- Binaire quiz — Kids -->
    <string name="binary_quiz_question_kids">Wat is binaire code?</string>
    <string name="binary_quiz_option_a_kids">Computertaal met alleen 0s en 1s</string>
    <string name="binary_quiz_option_b_kids">Een computervirus</string>
    <string name="binary_quiz_option_c_kids">Een robotentaal</string>
    <string name="binary_quiz_explanation_kids">Binair gebruikt alleen 0 en 1. Elke letter en afbeelding op een computer is gemaakt van 0s en 1s!</string>

    <!-- Scratch Quiz — Kids -->
    <string name="scratch_quiz_question_kids">Wat is Scratch?</string>
    <string name="scratch_quiz_option_a_kids">Spelletjes maken met gekleurde blokken</string>
    <string name="scratch_quiz_option_b_kids">Computers hacken</string>
    <string name="scratch_quiz_option_c_kids">Tekeningen maken</string>
    <string name="scratch_quiz_explanation_kids">Met Scratch maak je spelletjes door blokken aan elkaar te klikken. Geen typen nodig!</string>

    <!-- AI Quiz — Kids -->
    <string name="ai_quiz_question_kids">Wat betekent AI?</string>
    <string name="ai_quiz_option_a_kids">Kunstmatige Intelligentie</string>
    <string name="ai_quiz_option_b_kids">Automatisch Internet</string>
    <string name="ai_quiz_option_c_kids">Android Interface</string>
    <string name="ai_quiz_explanation_kids">AI betekent Kunstmatige Intelligentie. Het is een computer die kan leren en denken, net als jij!</string>

    <!-- Robot Quiz — Kids -->
    <string name="robot_quiz_question_kids">Hoe werkt een robot?</string>
    <string name="robot_quiz_option_a_kids">Hij volgt instructies</string>
    <string name="robot_quiz_option_b_kids">Hij denkt zoals een mens</string>
    <string name="robot_quiz_option_c_kids">Hij raadt</string>
    <string name="robot_quiz_explanation_kids">Een robot volgt code. Een programmeur schrijft instructies die de robot precies vertellen wat hij moet doen!</string>

    <!-- ============================================================ -->
    <!--  SENIOR AGENT (Teens) quizvragen — hier aanpassen voor teens -->
