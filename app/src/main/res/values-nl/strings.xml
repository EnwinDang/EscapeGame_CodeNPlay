    <!-- Binaire quiz — Kids -->
    <string name="binary_quiz_question_kids">Wat is binaire code?</string>
    <string name="binary_quiz_option_a_kids">Een manier waarop computers informatie opslaan met alleen 0s en 1s</string>
    <string name="binary_quiz_option_b_kids">Een soort computervirus</string>
    <string name="binary_quiz_option_c_kids">Een programmeertaal voor robots</string>
    <string name="binary_quiz_explanation_kids">Binair is een talstelsel met alleen 0 en 1. Elke letter, afbeelding en elk geluid op een computer wordt opgeslagen als een reeks van 0s en 1s.</string>

    <!-- Scratch Quiz — Kids -->
    <string name="scratch_quiz_question_kids">Waarvoor gebruik je Scratch?</string>
    <string name="scratch_quiz_option_a_kids">Programma\'s maken door gekleurde blokken te verbinden</string>
    <string name="scratch_quiz_option_b_kids">Computers hacken</string>
    <string name="scratch_quiz_option_c_kids">Tekeningen maken</string>
    <string name="scratch_quiz_explanation_kids">Met Scratch maak je programma\'s, spelletjes en animaties door gekleurde blokken te slepen en aan elkaar te klikken — zonder typen!</string>

    <!-- AI Quiz — Kids -->
    <string name="ai_quiz_question_kids">Waar staat AI voor?</string>
    <string name="ai_quiz_option_a_kids">Kunstmatige Intelligentie</string>
    <string name="ai_quiz_option_b_kids">Automatisch Internet</string>
    <string name="ai_quiz_option_c_kids">Android Interface</string>
    <string name="ai_quiz_explanation_kids">AI staat voor Kunstmatige Intelligentie — computers die kunnen leren en problemen oplossen, een beetje zoals mensen denken.</string>

    <!-- Robot Quiz — Kids -->
    <string name="robot_quiz_question_kids">Hoe weet een robot wat hij moet doen?</string>
    <string name="robot_quiz_option_a_kids">Hij volgt geprogrammeerde instructies</string>
    <string name="robot_quiz_option_b_kids">Hij denkt zelf na zoals een mens</string>
    <string name="robot_quiz_option_c_kids">Hij raadt willekeurig</string>
    <string name="robot_quiz_explanation_kids">Robots volgen code — instructies geschreven door een programmeur die de robot precies vertellen wat hij moet doen en wanneer.</string>

    <!-- ============================================================ -->
    <!--  SENIOR AGENT (Teens) quizvragen — hier aanpassen voor teens -->
    <!-- ============================================================ -->

    <!-- Binaire quiz — Teens -->
    <string name="binary_quiz_question_teens">Waarom gebruiken computers binair (basis-2) in plaats van decimaal (basis-10)?</string>
    <string name="binary_quiz_option_a_teens">Elektronische schakelingen kunnen betrouwbaar twee toestanden weergeven: aan (1) en uit (0)</string>
    <string name="binary_quiz_option_b_teens">Binaire berekeningen zijn sneller voor mensen te begrijpen</string>
    <string name="binary_quiz_option_c_teens">Binair gebruikt minder opslagruimte dan elk ander talstelsel</string>
    <string name="binary_quiz_explanation_teens">Computers gebruiken binair omdat transistoren twee stabiele toestanden hebben: aan en uit, die 1 en 0 voorstellen. Dit maakt binair de meest betrouwbare en efficiënte manier om gegevens elektrisch te verwerken.</string>

    <!-- Scratch Quiz — Teens -->
    <string name="scratch_quiz_question_teens">Welk programmeerprincipe vertegenwoordigt een \'herhaal\' blok in Scratch?</string>
    <string name="scratch_quiz_option_a_teens">Een lus — een reeks instructies die meerdere keren wordt uitgevoerd</string>
    <string name="scratch_quiz_option_b_teens">Een variabele — een container die een waarde opslaat</string>
    <string name="scratch_quiz_option_c_teens">Een event — iets wat een reactie triggert</string>
    <string name="scratch_quiz_explanation_teens">Een \'herhaal\' blok is een voorbeeld van een lus. Lussen laten een set instructies een bepaald aantal keren lopen, zonder dat je dezelfde code steeds opnieuw hoeft te schrijven.</string>

    <!-- AI Quiz — Teens -->
    <string name="ai_quiz_question_teens">Wat is een \'prompt\' in de context van AI?</string>
    <string name="ai_quiz_option_a_teens">Een instructie of invoer die aan een AI wordt gegeven om een antwoord te krijgen</string>
    <string name="ai_quiz_option_b_teens">Een type fout dat optreedt wanneer een AI-model faalt</string>
    <string name="ai_quiz_option_c_teens">De verwerkingssnelheid van een AI-systeem</string>
    <string name="ai_quiz_explanation_teens">Een prompt is de instructie of vraag die je aan een AI-systeem geeft. Het schrijven van duidelijke, goed gestructureerde prompts verbetert direct de kwaliteit van het antwoord van de AI — deze vaardigheid wordt prompt engineering genoemd.</string>

    <!-- Robot Quiz — Teens -->
    <string name="robot_quiz_question_teens">Wat is het verschil tussen een sensor en een actuator in een robot?</string>
    <string name="robot_quiz_option_a_teens">Een sensor verzamelt data uit de omgeving; een actuator produceert beweging of output</string>
    <string name="robot_quiz_option_b_teens">Een sensor stuurt de motoren aan; een actuator leest de code</string>
    <string name="robot_quiz_option_c_teens">Ze voeren dezelfde functie uit in verschillende programmeertalen</string>
    <string name="robot_quiz_explanation_teens">Sensoren zijn invoerapparaten die informatie verzamelen (bijv. afstand, licht, kleur). Actuatoren zijn uitvoerapparaten die de robot iets laten doen (bijv. motoren, luidsprekers, LED-lampjes).</string>

    <!-- AI Validatie Game — Teens -->
    <string name="ai_teens_intro_task">Het AI-systeem moet worden gecontroleerd. Voer de test uit en zorg dat alles veilig is. We rekenen op jou, agent!</string>
    <string name="ai_teens_btn_start">START VALIDATIE</string>
    <string name="ai_teens_step1_title">VALIDATIETEST</string>
    <string name="ai_teens_step1_body">Test het hertrainde model op de micro:bit.\nNoteer de gegenereerde validatiecode.\n\n→ Voer de testsequentie uit\n→ Noteer de code\n→ Voer die hieronder in</string>
    <string name="ai_teens_btn_enter_code">CODE INVOEREN</string>
    <string name="ai_teens_code_hint">Validatiecode van de micro:bit</string>
    <string name="ai_teens_input_error">Je hebt de reeks niet correct uitgevoerd. Probeer opnieuw.</string>
    <string name="ai_teens_code_title_1">VALIDATIECODE INVOEREN</string>
    <string name="ai_teens_mismatch_body">De cyberaanval heeft de AI-trainingsdata gecorrumpeerd. Het systeem kan niet worden vertrouwd totdat het opnieuw is gekalibreerd met schone data.\n\nJe moet het model opnieuw trainen om het datacenter te herstellen.</string>
    <string name="ai_teens_btn_diagnose">START HERKALIBRATIE</string>
    <string name="ai_teens_training_body">Het model traint op je nieuwe data.\nWacht tot de training klaar is, dan valideren.</string>
    <string name="ai_teens_btn_calibrated">MODEL VALIDEREN</string>
    <string name="ai_teens_step2_title">FASE 2 — HERVALIDATIE</string>
    <string name="ai_teens_step2_body">Het AI-model is opnieuw gekalibreerd.\nVoer de testsequentie opnieuw uit op de micro:bit.\n\nVoer de nieuwe validatiecode hieronder in.</string>
    <string name="ai_teens_code_title_2">HERVALIDATIECODE INVOEREN</string>
    <string name="ai_teens_revalidation_hint">Hervalidatiecode van de micro:bit</string>
    <string name="ai_teens_success_body">Het corrupte model is gewist en opnieuw getraind. De AI van het datacenter is weer online. Uitstekend werk, agent. De missie gaat verder!</string>

