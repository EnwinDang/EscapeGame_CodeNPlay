    <string name="ai_junior_intro_line2">Vind de indringer op het scherm.</string>
    <string name="ai_junior_intro_line3">Klik om hem te verwijderen!</string>
    <string name="ai_junior_intro_line4">Help ons de World Cloud te redden!</string>
