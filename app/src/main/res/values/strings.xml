    <!-- Binary Quiz — Kids -->
    <string name="binary_quiz_question_kids">What is binary code?</string>
    <string name="binary_quiz_option_a_kids">A way computers store information using only 0s and 1s</string>
    <string name="binary_quiz_option_b_kids">A type of computer virus</string>
    <string name="binary_quiz_option_c_kids">A programming language for robots</string>
    <string name="binary_quiz_explanation_kids">Binary is a number system using only 0 and 1. Every letter, picture, and sound on a computer is stored as a pattern of 0s and 1s.</string>

    <!-- Scratch Quiz — Kids -->
    <string name="scratch_quiz_question_kids">What is Scratch used for?</string>
    <string name="scratch_quiz_option_a_kids">Making programs by connecting colorful blocks</string>
    <string name="scratch_quiz_option_b_kids">Hacking into computers</string>
    <string name="scratch_quiz_option_c_kids">Drawing pictures</string>
    <string name="scratch_quiz_explanation_kids">Scratch lets you make programs, games, and animations by dragging and snapping colorful blocks together — no typing needed!</string>

    <!-- AI Quiz — Kids -->
    <string name="ai_quiz_question_kids">What does AI stand for?</string>
    <string name="ai_quiz_option_a_kids">Artificial Intelligence</string>
    <string name="ai_quiz_option_b_kids">Automatic Internet</string>
    <string name="ai_quiz_option_c_kids">Android Interface</string>
    <string name="ai_quiz_explanation_kids">AI stands for Artificial Intelligence — computers that can learn and solve problems, a bit like how humans think.</string>

    <!-- Robot Quiz — Kids -->
    <string name="robot_quiz_question_kids">How does a robot know what to do?</string>
    <string name="robot_quiz_option_a_kids">It follows programmed instructions</string>
    <string name="robot_quiz_option_b_kids">It thinks for itself like a human</string>
    <string name="robot_quiz_option_c_kids">It guesses randomly</string>
    <string name="robot_quiz_explanation_kids">Robots follow code — instructions written by a programmer that tell the robot exactly what to do and when.</string>

