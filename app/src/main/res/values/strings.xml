    <!--  SENIOR AGENT (Teens) quiz strings — edit here for teens     -->
    <!-- ============================================================ -->

    <!-- Binary Quiz — Teens -->
    <string name="binary_quiz_question_teens">Why do computers use binary (base-2) instead of decimal (base-10)?</string>
    <string name="binary_quiz_option_a_teens">Electronic circuits can reliably represent two states: on (1) and off (0)</string>
    <string name="binary_quiz_option_b_teens">Binary calculations are faster for humans to understand</string>
    <string name="binary_quiz_option_c_teens">Binary uses less storage space than any other number system</string>
    <string name="binary_quiz_explanation_teens">Computers use binary because transistors have two stable states: on and off, representing 1 and 0. This makes binary the most reliable and efficient way to process data electrically.</string>

    <!-- Scratch Quiz — Teens -->
    <string name="scratch_quiz_question_teens">In Scratch, what programming concept does a \'repeat\' block represent?</string>
    <string name="scratch_quiz_option_a_teens">A loop — a sequence of instructions that executes multiple times</string>
    <string name="scratch_quiz_option_b_teens">A variable — a container that stores a value</string>
    <string name="scratch_quiz_option_c_teens">An event — something that triggers a response</string>
    <string name="scratch_quiz_explanation_teens">A \'repeat\' block is an example of a loop. Loops allow a set of instructions to run a specified number of times, avoiding the need to write the same code repeatedly.</string>

    <!-- AI Quiz — Teens -->
    <string name="ai_quiz_question_teens">What is a "prompt" in the context of AI?</string>
    <string name="ai_quiz_option_a_teens">An instruction or input you give to an AI to get a response</string>
    <string name="ai_quiz_option_b_teens">A type of error that occurs when an AI model fails</string>
    <string name="ai_quiz_option_c_teens">The processing speed of an AI system</string>
    <string name="ai_quiz_explanation_teens">A prompt is the instruction or question you give to an AI system. Writing clear, well-structured prompts directly improves the quality of the AI\'s response — this skill is called prompt engineering.</string>

    <!-- Robot Quiz — Teens -->
    <string name="robot_quiz_question_teens">What is the difference between a sensor and an actuator in a robot?</string>
    <string name="robot_quiz_option_a_teens">A sensor collects data from the environment; an actuator produces movement or output</string>
    <string name="robot_quiz_option_b_teens">A sensor controls the motors; an actuator reads the code</string>
    <string name="robot_quiz_option_c_teens">They perform the same function in different programming languages</string>
    <string name="robot_quiz_explanation_teens">Sensors are input devices that gather information (e.g. distance, light, color). Actuators are output devices that make the robot do something (e.g. motors, speakers, LEDs).</string>

