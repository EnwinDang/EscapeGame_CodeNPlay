    <!-- Binary Quiz — Kids -->
    <string name="binary_quiz_question_kids">What is binary code?</string>
    <string name="binary_quiz_option_a_kids">Computer language with only 0s and 1s</string>
    <string name="binary_quiz_option_b_kids">A computer virus</string>
    <string name="binary_quiz_option_c_kids">A robot language</string>
    <string name="binary_quiz_explanation_kids">Binary uses only 0 and 1. Every letter and picture on a computer is made of 0s and 1s!</string>

    <!-- Scratch Quiz — Kids -->
    <string name="scratch_quiz_question_kids">What is Scratch?</string>
    <string name="scratch_quiz_option_a_kids">Make games with colourful blocks</string>
    <string name="scratch_quiz_option_b_kids">Hack computers</string>
    <string name="scratch_quiz_option_c_kids">Draw pictures</string>
    <string name="scratch_quiz_explanation_kids">Scratch lets you make games and animations by clicking blocks together. No typing needed!</string>

    <!-- AI Quiz — Kids -->
    <string name="ai_quiz_question_kids">What does AI mean?</string>
    <string name="ai_quiz_option_a_kids">Artificial Intelligence</string>
    <string name="ai_quiz_option_b_kids">Automatic Internet</string>
    <string name="ai_quiz_option_c_kids">Android Interface</string>
    <string name="ai_quiz_explanation_kids">AI means Artificial Intelligence. It\'s a computer that can learn and think, just like you!</string>

    <!-- Robot Quiz — Kids -->
    <string name="robot_quiz_question_kids">How does a robot work?</string>
    <string name="robot_quiz_option_a_kids">It follows instructions</string>
    <string name="robot_quiz_option_b_kids">It thinks like a human</string>
    <string name="robot_quiz_option_c_kids">It guesses</string>
    <string name="robot_quiz_explanation_kids">A robot follows code. A programmer writes instructions that tell the robot exactly what to do!</string>

